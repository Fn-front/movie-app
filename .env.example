# Next.js
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth.js
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# TMDb API
NEXT_PUBLIC_TMDB_API_KEY=your-tmdb-api-token

# Resend (メール送信)
RESEND_API_KEY=your-resend-api-key

# Playwright (テスト用)
PLAYWRIGHT_BROWSERS_PATH=node_modules/.cache/ms-playwright


E2E_TEST_USER_EMAIL=your-email
E2E_TEST_USER_PASSWORD=your-account

CRON_SECRET=cron-secret-key

GITHUB_CLIENT_ID=github-client-id
GITHUB_CLIENT_SECRET=github-client-secret

GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret

RESEND_API_KEY=resend-api-key
RESEND_FROM_EMAIL=resend-from-email